<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TarkovMapCompanion</RootNamespace>
    <AssemblyName>TarkovMapCompanion</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      Fallback for local builds only. Release builds override this from the git tag
      (see .github/workflows/release.yml), so do not rely on it to identify a shipped binary.
    -->
    <Version>0.12.2</Version>

    <!-- The SDK otherwise appends "+<commit sha>", which the About window would show verbatim. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Tarkov Map Companion</Product>
    <Company>casey</Company>
    <Description>Reads position and heading out of Escape from Tarkov screenshot filenames and plots them on community maps. Does not interact with the game.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <!--
      Official Avalonia package, so it version-locks with the rest of the suite and brings no
      SkiaSharp of its own. That is what makes it safe next to the pin in Directory.Build.props;
      a third-party picker with its own Skia dependency would not be.
    -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Svg.Skia" Version="$(SvgSkiaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Snapshots\*.json" />
    <EmbeddedResource Include="Data\Snapshots\*.json.gz" />
    <!--
      ".zh." in the middle of the name makes MSBuild read the segment as a culture and route the
      file to a satellite assembly instead of embedding it, which leaves the runtime lookup
      empty. Pin the logical name so it lands under the exact id ExtractNotesStore asks for.
    -->
    <EmbeddedResource Update="Data\Snapshots\extract-notes.zh.json">
      <WithCulture>false</WithCulture>
      <LogicalName>TarkovMapCompanion.Data.Snapshots.extract-notes.zh.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Localization\StringsEn.json" />
    <EmbeddedResource Include="Localization\StringsZh.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TarkovMapCompanion.Tests" />
  </ItemGroup>

</Project>


