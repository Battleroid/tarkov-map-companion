<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:TarkovMapCompanion.Rendering">

  <!--
    Chrome styling on top of FluentTheme. Only overrides what the token palette needs; anything
    not listed here keeps Fluent's defaults deliberately.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    Letterbox behind the map. The map artwork itself is dark in both themes, so this only affects
    the margin around a map that does not fill the viewport.
  -->
  <Style Selector="rendering|MapCanvas">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <!--
    Chrome floating over the map: present enough to read, faint enough that it is not competing
    with the thing it is sitting on top of. Never set Opacity on one of these from code-behind; a
    local value beats a style setter permanently and the hover state silently stops working. Use
    Classes.Set("attention", ...) instead.
  -->
  <Style Selector="Border.mapOverlay">
    <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="Border.mapOverlay:pointerover">
    <Setter Property="Opacity" Value="1.0" />
  </Style>

  <!-- Declared last so it wins: something that needs reading is never translucent. -->
  <Style Selector="Border.mapOverlay.attention">
    <Setter Property="Opacity" Value="1.0" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- Section heading: uppercase tracking reads well in a monospace face at small sizes. -->
  <Style Selector="TextBlock.heading">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.08" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <!--
    ToggleButton needs its own copy of all of this. Avalonia type selectors match the exact type,
    not derived ones, so the Button rules above never reach a ToggleButton even though a
    ToggleButton is a Button. That presents as a couple of toolbar buttons arriving in raw Fluent
    styling for no visible reason. By the same rule this does not leak onto CheckBox or
    RadioButton, which also derive from ToggleButton and are styled separately below.
  -->
  <Style Selector="ToggleButton">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    Armed has to be unmistakable. While Mark Route is on, a click on the map drops a pin instead of
    selecting an exit, and while Follow Player is on the view will move on its own. Both are states
    you need to be able to see without hunting for a tick mark.
  -->
  <Style Selector="ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="CheckBox, RadioButton, ComboBox, TextBox, NumericUpDown, Slider">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Keyboard focus must stay obvious against both surfaces. -->
  <Style Selector=":is(Control):focus-visible /template/ Border#FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

</Styles>
