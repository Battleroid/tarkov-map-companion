<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Semantic color tokens. Everything in the app references these, never a raw hex, so the two
    variants below are the single place light/dark is decided.

    Contrast targets: body text >= 7:1 against its surface (AA large / AAA body), secondary text
    and borders >= 4.5:1. The map itself is drawn by Skia and picks its own marker colors from
    MarkerPalette; these tokens are chrome only.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <!-- Surfaces: near-black so the dark tarkov.dev maps sit in the page rather than glowing. -->
      <Color x:Key="SurfaceBaseColor">#12151A</Color>
      <Color x:Key="SurfacePanelColor">#181C23</Color>
      <Color x:Key="SurfaceRaisedColor">#212731</Color>
      <Color x:Key="SurfaceHoverColor">#2A313D</Color>
      <Color x:Key="SurfaceActiveColor">#333C4A</Color>

      <Color x:Key="BorderSubtleColor">#2C333F</Color>
      <Color x:Key="BorderStrongColor">#414B5A</Color>

      <Color x:Key="TextPrimaryColor">#E6EAF0</Color>
      <Color x:Key="TextSecondaryColor">#A3AEBF</Color>
      <Color x:Key="TextDisabledColor">#6B7686</Color>
      <Color x:Key="TextOnAccentColor">#0B0E12</Color>

      <!-- Tarkov-ish desaturated amber. Bright enough for 4.5:1 on SurfaceBase. -->
      <Color x:Key="AccentColor">#D8A657</Color>
      <Color x:Key="AccentHoverColor">#E7B96F</Color>
      <Color x:Key="AccentMutedColor">#4A3D24</Color>

      <Color x:Key="SuccessColor">#7FB069</Color>
      <Color x:Key="WarningColor">#E0A458</Color>
      <Color x:Key="DangerColor">#E06C75</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="SurfaceBaseColor">#F7F8FA</Color>
      <Color x:Key="SurfacePanelColor">#FFFFFF</Color>
      <Color x:Key="SurfaceRaisedColor">#EDEFF3</Color>
      <Color x:Key="SurfaceHoverColor">#E2E6EC</Color>
      <Color x:Key="SurfaceActiveColor">#D3D9E2</Color>

      <Color x:Key="BorderSubtleColor">#D8DDE5</Color>
      <Color x:Key="BorderStrongColor">#AEB7C4</Color>

      <Color x:Key="TextPrimaryColor">#161A20</Color>
      <Color x:Key="TextSecondaryColor">#525C6B</Color>
      <Color x:Key="TextDisabledColor">#8B95A3</Color>
      <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

      <!-- Darker than the dark-theme accent: amber on white needs to come down to clear 4.5:1. -->
      <Color x:Key="AccentColor">#8A5A00</Color>
      <Color x:Key="AccentHoverColor">#6E4700</Color>
      <Color x:Key="AccentMutedColor">#F0E2C6</Color>

      <Color x:Key="SuccessColor">#2F6B3A</Color>
      <Color x:Key="WarningColor">#8A5A00</Color>
      <Color x:Key="DangerColor">#B3323C</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Brushes over the variant-resolved colors. Consumers bind to these. -->
  <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{DynamicResource SurfaceBaseColor}" />
  <SolidColorBrush x:Key="SurfacePanelBrush" Color="{DynamicResource SurfacePanelColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{DynamicResource SurfaceActiveColor}" />

  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource TextOnAccentColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource AccentMutedColor}" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />

  <!--
    Monospace throughout, per the brief. Cascadia Mono ships with Windows 11 and Consolas with
    every Windows before it, so this resolves without bundling a font file.
  -->
  <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,DejaVu Sans Mono,monospace</FontFamily>

  <!-- Spacing scale. Keeps padding consistent without magic numbers scattered through views. -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>

  <CornerRadius x:Key="RadiusSmall">3</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">5</CornerRadius>

</ResourceDictionary>
