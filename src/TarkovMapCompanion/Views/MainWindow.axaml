<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:maps="using:TarkovMapCompanion.Maps"
        xmlns:data="using:TarkovMapCompanion.Data"
        xmlns:views="using:TarkovMapCompanion.Views"
        mc:Ignorable="d"
        x:Class="TarkovMapCompanion.Views.MainWindow"
        x:DataType="maps:GameMap"
        Title="Tarkov Map Companion"
        Width="1280" Height="860"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource SurfaceBaseBrush}">

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="heading" VerticalAlignment="Center" Text="MAP" />
          <ComboBox Name="MapSelector" Width="220" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    Margin="16,0,0,0" VerticalAlignment="Center">
          <Button Name="FitButton" Content="Fit" ToolTip.Tip="Zoom out to the whole map" />
          <!-- Buttons rather than checkboxes: all three arm a mode that changes what the map does
               with your clicks or your view, and a filled button says "on" from across a room in a
               way a tick in a box does not. -->
          <ToggleButton Name="FollowToggle" Classes="mode" Content="Follow Player"
                        ToolTip.Tip="Recenter on the player when a new screenshot arrives. Panning and zooming will not switch this off." />
          <ToggleButton Name="FocusToggle" Classes="mode" Content="Focus Exit"
                        ToolTip.Tip="Zoom so the player and the selected exit both stay in view, tightening as you get closer. Turning it off puts your previous view back." />
          <ToggleButton Name="MarkToggle" Classes="mode" Content="Mark Route"
                        ToolTip.Tip="Click the map to drop numbered markers in the order you want to visit them. Click Mark Route again, or press Escape, to finish." />
          <ToggleButton Name="AnnotateToggle" Classes="mode" Content="Add Note"
                        ToolTip.Tip="Click the map to write a label on it. Click Add Note again, or press Escape, to finish." />
          <Button Name="ClearMarksButton" Content="Clear marks" IsVisible="False"
                  ToolTip.Tip="Remove every marker and point the guide line back at the selected exit" />
        </StackPanel>

        <!-- Map suggestion, shown only when a fix lands off the current map. -->
        <Border Grid.Column="2" Name="SuggestionBar"
                IsVisible="False"
                Margin="16,0"
                Padding="10,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentMutedBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSmall}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Name="SuggestionText" VerticalAlignment="Center" />
            <Button Name="SuggestionAccept" Content="Switch" Padding="8,2" />
            <Button Name="SuggestionDismiss" Content="No" Padding="8,2" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleButton Name="PanelToggle" Classes="mode" Content="Panel" IsChecked="True"
                        ToolTip.Tip="Show or hide the exits, quests and notes panel. Drag its edge to resize." />
          <ToggleButton Name="MinimapToggle" Classes="mode" Content="Minimap"
                        ToolTip.Tip="Pop out a small always-on-top map that can sit over the game" />
          <CheckBox Name="AlwaysOnTopToggle" Content="On top" VerticalAlignment="Center" />
          <Button Name="ThemeButton" Content="Theme" ToolTip.Tip="Cycle dark, light, follow system" />
          <Button Name="PreferencesButton" Content="Settings" />
          <Button Name="AboutButton" Content="About" />
        </StackPanel>

      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Name="StatusText" Classes="secondary" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Name="PositionText" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!--
      The map and the side panel, with a grip between them. A fixed width was fine with one list in
      it and stopped being fine at three: a quest row carries two buttons after a wrapping task
      name, and at 290 pixels the second of them ends up under the scrollbar.
    -->
    <Grid Name="ContentGrid">
      <!--
        Quest detail on the left, map in the middle, lists on the right. Reading a quest and
        browsing for one are different jobs: the list wants to be narrow and scannable, and the
        detail wants room for a paragraph of objective text at a size somebody can actually read.
        Columns are reached from code by index; a ColumnDefinition takes no Name.
      -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0" MaxWidth="700" />
        <ColumnDefinition Width="Auto" />
        <!-- The map keeps a floor, so dragging either panel wide cannot squeeze it to nothing. -->
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="290" MinWidth="220" MaxWidth="700" />
      </Grid.ColumnDefinitions>

      <!-- Everything about one quest, at a size that does not need squinting at. -->
      <Border Grid.Column="0" Name="QuestPaneHost" IsVisible="False"
              Background="{DynamicResource SurfacePanelBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,10,6">
            <TextBlock Grid.Column="0" Classes="heading" FontSize="11" Text="QUEST" VerticalAlignment="Center" />
            <Button Grid.Column="1" Name="QuestPaneCloseButton" Content="✕" FontSize="11"
                    Padding="6,1" MinHeight="0" ToolTip.Tip="Close this pane" />
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="12,0,4,10">
            <StackPanel Name="QuestPane" Spacing="0" Margin="0,0,10,0" />
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Name="QuestPaneSplitter"
                    Width="5" IsVisible="False"
                    Background="{DynamicResource BorderSubtleBrush}"
                    ResizeDirection="Columns"
                    ToolTip.Tip="Drag to resize the quest pane" />

    <!--
      Exits, quests and notes as tabs rather than three panels stacked in one column. All three are
      lists that want the full height of the window, and a quest list folded into an expander above
      the exits would have shown four rows out of five hundred.
    -->
    <Border Grid.Column="4" Name="SidePanelHost"
            Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1,0,0,0">
      <TabControl Name="SidePanel" Padding="0">

      <TabItem Header="Exits">
      <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Margin="10,10,10,6" Spacing="5">
          <TextBlock Classes="heading" Text="EXITS" />
          <ComboBox Name="ExitFilterBox" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Hide exits your faction cannot use" />
          <CheckBox Name="SortByDistanceToggle" Content="Nearest first" FontSize="12"
                    ToolTip.Tip="Order the list by distance from your last known position" />
          <CheckBox Name="ReadExitsToggle" Content="Read exits from screenshot" FontSize="12"
                    ToolTip.Tip="When a screenshot catches the in-game extraction list (double-tap O), dim the exits it does not name. Reads the picture only; nothing touches the game." />

          <!-- What the last read found, and a way out of it. Only shown once something was read. -->
          <Border Name="ReadExitsBar" IsVisible="False"
                  Padding="7,5"
                  Background="{DynamicResource SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSmall}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock Name="ReadExitsText" Grid.Column="0" FontSize="11" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Name="ClearReadExitsButton" Grid.Column="1" Content="Clear"
                      FontSize="11" Padding="7,2" VerticalAlignment="Center"
                      ToolTip.Tip="Show every exit again" />
            </Grid>
          </Border>

          <!--
            Clicking the chosen exit again also drops it, but only if you can find it: with the
            list sorted by distance and a guide line pointing off screen, the marker you selected
            may not be anywhere you are looking. A button is the answer that does not require
            hunting for the thing you want to stop looking at.
          -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Name="ExitHint" Classes="secondary" FontSize="11"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Pick one to draw a guide line from the player." />
            <Button Grid.Column="1" Name="ClearSelectionButton" Content="Clear" IsVisible="False"
                    FontSize="11" Padding="7,2" VerticalAlignment="Center"
                    ToolTip.Tip="Stop pointing at this exit" />
          </Grid>
        </StackPanel>

        <!--
          Requirements live in the row itself rather than in a panel underneath the list. A separate
          pane meant reading the exit's name in one place and its conditions in another, six inches
          apart, and it repeated the name and distance that were already on screen. Double-click a
          row to fold its requirements away.
        -->
        <ListBox Grid.Row="1" Name="ExtractList" Margin="6,0,6,6"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:MapPoi">
              <!-- Faded when the game did not list this exit for the current raid. Still selectable:
                   the list comes from reading a screenshot, which can be wrong. -->
              <StackPanel Opacity="{Binding ListOpacity}" Spacing="2" Margin="0,1">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding DistanceLabel}"
                             Classes="secondary" FontSize="11"
                             VerticalAlignment="Center" />
                  <!-- A conditional exit is flagged whether or not the row is expanded. Folding the
                       requirements away is decluttering; hiding that there are any would be a trap. -->
                  <TextBlock Grid.Column="2" Text="!"
                             IsVisible="{Binding IsConditional}"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource WarningBrush}"
                             ToolTip.Tip="This exit has conditions. Double-click to fold them away." />
                </Grid>

                <StackPanel IsVisible="{Binding ShowDetails}" Margin="0,1,0,3" Spacing="1">
                  <TextBlock Text="{Binding SubtitleLabel}"
                             IsVisible="{Binding SubtitleLabel.Length}"
                             Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </Grid>
      </TabItem>

      <!--
        Quests. Ticked by hand, because which ones you have accepted lives in your profile on BSG's
        servers and this app reads files rather than accounts. Only ticked tasks draw: Lighthouse
        alone has 169 positioned objectives, so drawing them all would bury the map.
      -->
      <TabItem Header="Quests">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="10,10,10,6" Spacing="5">
          <TextBox Name="QuestSearchBox" FontSize="12" Watermark="Search tasks and objectives" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <CheckBox Grid.Column="0" Name="QuestThisMapBox" Content="This map" FontSize="12"
                      ToolTip.Tip="Only tasks with an objective on the map you are looking at" />
            <CheckBox Grid.Column="1" Name="QuestTrackedBox" Content="Tracked" FontSize="12"
                      ToolTip.Tip="Only the tasks you have ticked" />
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <CheckBox Grid.Column="0" Name="QuestKappaBox" Content="Kappa" FontSize="12"
                      ToolTip.Tip="Only tasks required for the Kappa container" />
            <CheckBox Grid.Column="1" Name="QuestLevelBox" Content="My level" FontSize="12"
                      ToolTip.Tip="Hide tasks above your level" />
          </Grid>

          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center" FontSize="12"
                       Classes="secondary" />
            <NumericUpDown Grid.Column="1" Name="PlayerLevelBox" Minimum="1" Maximum="79"
                           Increment="1" Width="96" FormatString="0" />
            <Button Grid.Column="2" Name="ClearQuestsButton" Content="Untrack all"
                    HorizontalAlignment="Right" FontSize="11" Padding="7,2" />
          </Grid>

          <CheckBox Name="QuestLabelsBox" Content="Label markers on the map" FontSize="12"
                    ToolTip.Tip="Off still labels whichever marker the pointer is on" />

          <TextBlock Name="QuestHint" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="6,0,0,0">
          <!-- Right margin clears the overlay scrollbar, which is drawn on top of the content
               rather than beside it, and was sitting exactly where the wiki button is. -->
          <StackPanel Name="QuestList" Spacing="1" Margin="0,0,14,0" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Name="QuestOrigin" Classes="secondary" FontSize="10"
                   Margin="10,4,10,8" TextWrapping="Wrap" />

      </Grid>
      </TabItem>

      <!--
        Notes. Local by default and shared only if you say so, because a set of labels is something
        somebody builds up over weeks rather than a plan for the next ten minutes.
      -->
      <TabItem Header="Notes">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="10,10,10,6" Spacing="6">
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Press Add Note, then click the map to label a spot. Click any note on the map to edit or delete it. Notes are saved to disk and stay on the map you wrote them on." />

          <CheckBox Name="ShowAnnotationsBox" Content="Show notes on the map" FontSize="12" />
          <CheckBox Name="ShareAnnotationsBox" Content="Share my notes with the party" FontSize="12"
                    ToolTip.Tip="Sends your notes to the squad. Theirs appear in their color and are never saved to your file." />

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Name="ImportNotesButton" Content="Import" FontSize="11" Padding="6,2"
                    ToolTip.Tip="Merge a shared notes file, or a plain map,x,z,text list" />
            <Button Grid.Column="1" Name="ExportNotesButton" Content="Export" FontSize="11" Padding="6,2"
                    ToolTip.Tip="Write your notes to a file somebody else can import" />
            <Button Grid.Column="2" Name="ClearNotesButton" Content="Clear map" FontSize="11" Padding="6,2"
                    ToolTip.Tip="Delete every note you wrote on the map you are looking at" />
          </Grid>

          <TextBlock Name="NotesHint" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="6,0,0,0">
          <StackPanel Name="NotesList" Spacing="1" Margin="0,0,14,0" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Name="NotesPath" Classes="secondary" FontSize="10"
                   Margin="10,4,10,8" TextWrapping="Wrap" />

      </Grid>
      </TabItem>

      </TabControl>
    </Border>

    <!--
      Drag to resize, double-click to fold the panel away. Both matter: the width is a preference
      people have opinions about, and on a small screen the map is the thing you actually want.
    -->
    <GridSplitter Grid.Column="3" Name="PanelSplitter"
                  Width="5"
                  Background="{DynamicResource BorderSubtleBrush}"
                  ResizeDirection="Columns"
                  ToolTip.Tip="Drag to resize the panel, double-click to hide it" />

    <!--
      The map, and the chrome that floats over it. A Panel z-orders by child order and the canvas
      is inserted at index 0 in code, so everything declared here draws on top of it and receives
      the clicks that land on it.

      Both of these describe the map rather than the exit list, so they belong on the map: a whole
      side pane for two floor checkboxes was a lot of window for something most maps do not use.
    -->
    <Panel Grid.Column="2" Name="MapHost">

      <!--
        Where a note gets typed. Floats over the map rather than opening a dialog: you have just
        clicked a spot and the words belong next to it, not in a window covering it.
      -->
      <Border Name="AnnotationEditor" Classes="mapOverlay attention" IsVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
              MinWidth="320">
        <StackPanel Spacing="6">
          <TextBlock Name="AnnotationEditorTitle" Classes="heading" FontSize="11" Text="LABEL THIS SPOT" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Name="AnnotationTextBox" FontSize="12" Width="240"
                     Watermark="Dorms, stash, sniper spot..." MaxLength="60" />
            <Button Grid.Column="1" Name="AnnotationSaveButton" Content="Save" FontSize="11" Padding="8,2" />
            <!-- Only when editing one that exists, so deleting is where you already are: you
                 clicked the note, and the thing you want to do to it is right there. -->
            <Button Grid.Column="2" Name="AnnotationDeleteButton" Content="Delete" IsVisible="False"
                    FontSize="11" Padding="8,2" ToolTip.Tip="Remove this note from the map" />
            <Button Grid.Column="3" Name="AnnotationCancelButton" Content="Cancel" FontSize="11" Padding="8,2" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Floors, for the maps that have any. -->
      <Border Name="FloorOverlay" Classes="mapOverlay" IsVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
        <StackPanel Spacing="5">
          <ToggleButton Name="FloorOverlayToggle" Classes="overlayHeader" Content="Levels" FontSize="11" Padding="8,3"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Turn map levels on and off. Ground has to be off to see anything underneath it." />
          <StackPanel Name="FloorBody" Spacing="3" IsVisible="False" MaxWidth="180">
            <StackPanel Name="FloorList" Spacing="2" />
            <TextBlock Name="FloorHint" IsVisible="False" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!--
        What is drawn on the map, which is a thing about the map rather than about the exit list.
        Bottom-left, under the levels, so the two pieces of "what am I looking at" chrome share a
        corner instead of being split across the window.
      -->
      <Border Name="LayersOverlay" Classes="mapOverlay"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10">
        <StackPanel Spacing="5">
          <ToggleButton Name="LayersOverlayToggle" Classes="overlayHeader" Content="Layers"
                        FontSize="11" Padding="8,3" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Which points of interest and spawn data are drawn" />

          <StackPanel Name="LayersBody" Spacing="6" IsVisible="False" Width="210">
            <ScrollViewer MaxHeight="260">
              <StackPanel Name="LayerList" Spacing="2" />
            </ScrollViewer>

            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Padding="0,6,0,0">
              <StackPanel Spacing="4">
                <CheckBox Name="HeatmapToggle" Content="Spawn heatmap" FontSize="12" />
                <StackPanel Name="HeatmapGroups" Spacing="2" Margin="14,0,0,0" />
                <TextBlock Name="HeatmapRadiusLabel" Classes="secondary" FontSize="11" Margin="0,4,0,0" />
                <Slider Name="HeatmapRadius" Minimum="10" Maximum="150" />
                <TextBlock Name="HeatmapOpacityLabel" Classes="secondary" FontSize="11" />
                <Slider Name="HeatmapOpacity" Minimum="0.1" Maximum="1.0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <!--
        Squad position sharing. Collapsed to a single pill until it has something to say.

        The width lives on the body, not the border: a fixed-width border sizes the collapsed pill
        to 250px too, and a wide empty bar with a one-word label in it reads as a text field rather
        than a button. Collapsed, this needs to look exactly like the Levels pill opposite it.
      -->
      <Border Name="PartyOverlay" Classes="mapOverlay"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
        <StackPanel Spacing="6">
          <ToggleButton Name="PartyOverlayToggle" Classes="overlayHeader" Content="Party" FontSize="11" Padding="8,3"
                        HorizontalAlignment="Stretch" />

          <StackPanel Name="PartyBody" Spacing="6" IsVisible="False" Width="250">

            <StackPanel Name="PartyIdlePanel" Spacing="6">
              <!-- Two star columns rather than a StackPanel, so the pair reads as one control
                   instead of a wide button next to a narrow one. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Grid.Column="0" Name="HostPartyButton" Content="Host" FontSize="11"
                        Padding="8,3" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Name="JoinPartyButton" Content="Join" FontSize="11"
                        Padding="8,3" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
              </Grid>
              <TextBox Name="JoinCodeBox" Watermark="Paste a session code" FontSize="11" />
              <SelectableTextBlock Name="PartyIdleHint" Classes="secondary" FontSize="11"
                                   TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Name="PartyActivePanel" Spacing="6" IsVisible="False">
              <StackPanel Name="PartyCodePanel" Spacing="3">
                <TextBlock Classes="secondary" FontSize="11" Text="Share this code with your squad:" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <SelectableTextBlock Name="PartyCodeText" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center" />
                  <Button Name="CopyCodeButton" Content="Copy" FontSize="11" Padding="7,2" />
                </StackPanel>
              </StackPanel>

              <ItemsControl Name="PartyRoster">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="views:PartyRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" Margin="0,1">
                      <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{Binding Swatch}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11"
                                 Classes="secondary" VerticalAlignment="Center" />
                      <!-- Round trip to the host, blank until a heartbeat has come back. -->
                      <TextBlock Grid.Column="3" Text="{Binding Latency}" FontSize="10"
                                 Classes="secondary" VerticalAlignment="Center" Opacity="0.75"
                                 ToolTip.Tip="Round trip to the host, from the last heartbeat" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Name="LeavePartyButton" Content="Stop session" FontSize="11" Padding="8,3"
                      HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Same information before anything has been tried, so it is findable rather than
                 only appearing once something has already gone wrong. -->
            <Border Name="PartyFailedPanel" IsVisible="False"
                    Padding="7,5"
                    Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSmall}">
              <SelectableTextBlock Name="PartyFailedText" FontSize="11" TextWrapping="Wrap" />
            </Border>

            <!-- Where you are reachable while hosting, and nothing at all when idle. -->
            <SelectableTextBlock Name="PartyHint" Classes="secondary" FontSize="11"
                                 TextWrapping="Wrap" IsVisible="False" />
          </StackPanel>
        </StackPanel>
      </Border>

    </Panel>

    </Grid>

  </DockPanel>

</Window>
