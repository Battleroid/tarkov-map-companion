<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="TarkovMapCompanion.Views.PreferencesWindow"
        Title="Preferences"
        Width="600" Height="620"
        MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <DockPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Name="SettingsPathText"
                   Classes="secondary" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Name="CloseButton" Content="Close" Classes="accent" Padding="16,4" />
      </Grid>
    </Border>

    <!--
      A ScrollViewer measures its content with unbounded width, so the TextBox below reports the
      full pixel width of whatever folder path it holds, the star column sizes to that, and every
      wrapping TextBlock in the panel then wraps to a width wider than the window. Pinning the
      content to the viewport width is what actually stops that; HorizontalScrollBarVisibility
      alone does not, because the Border is what has to be constrained.
      Padding lives on the Border, inside MaxWidth, rather than on the ScrollViewer, so the
      content plus its margins still fits.
    -->
    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <Border Padding="16" MaxWidth="{Binding #Scroller.Viewport.Width}">
      <StackPanel Spacing="18">

        <!--
          Every section is boxed. With eight of them in one scroller, a heading alone did not say
          where one topic stopped and the next started, so a setting read as belonging to whichever
          heading happened to be above it on screen.
        -->

        <!-- Screenshots -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="SCREENSHOTS" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="The folder Escape from Tarkov writes screenshots to. Only the filename is read; the image itself is never opened." />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Name="FolderBox" FontSize="12" />
            <Button Grid.Column="1" Name="BrowseButton" Content="Browse" />
            <Button Grid.Column="2" Name="DetectFolderButton" Content="Find"
                    ToolTip.Tip="Look in every place Tarkov might be writing screenshots, including a OneDrive-relocated Documents folder" />
            <Button Grid.Column="3" Name="DefaultFolderButton" Content="Default" />
          </Grid>
          <TextBlock Name="FolderStatus" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <!-- Culling. Destructive, so it gets its own framing and an explicit warning. -->
        <Border Classes="panel" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="REMOVING OLD SCREENSHOTS" />
            <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                       Text="Off by default. When enabled this deletes files from the folder above. Deleted files go to the Recycle Bin, and only files matching Tarkov's own screenshot naming are ever touched." />

            <RadioButton Name="CullOff" GroupName="Cull" Content="Keep everything" />
            <RadioButton Name="CullKeepLatest" GroupName="Cull" Content="Keep only the newest" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
              <NumericUpDown Name="CullCount" Minimum="1" Maximum="10000" Increment="5"
                             Width="120" FormatString="0" />
              <TextBlock Text="screenshots" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <RadioButton Name="CullAfterRead" GroupName="Cull" Content="Delete each screenshot once its position has been read" />

            <TextBlock Name="CullWarning" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" IsVisible="False" />
          </StackPanel>
        </Border>

        <!-- View -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="VIEW" />
          <CheckBox Name="SmoothCameraBox" Content="Glide the view to its destination instead of jumping" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Follow Player lives on the toolbar. Panning and zooming no longer switch it off; only the button does." />
          <CheckBox Name="SuggestMapBox" Content="Offer to switch maps when a position lands off the current one" />
          <CheckBox Name="AutoSwitchBox" Content="Switch automatically instead of asking" Margin="24,0,0,0" />

          <TextBlock Name="PaddingLabel" Classes="secondary" FontSize="11" Margin="0,6,0,0" />
          <Slider Name="PaddingSlider" Minimum="0" Maximum="0.75" />

          <TextBlock Name="TrailLabel" Classes="secondary" FontSize="11" />
          <Slider Name="TrailSlider" Minimum="0" Maximum="60" />

          <TextBlock Name="RaidLengthText" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <!-- Your marker -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="YOUR MARKER" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="How you are drawn on your own map, and the color your squad sees you as." />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Color" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ColorPicker Name="PlayerColorPicker" Width="120" HorizontalAlignment="Left" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Size" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="PlayerSizeBox" Minimum="10" Maximum="48" Increment="1"
                           Width="120" FormatString="0" />
            <TextBlock Text="px" VerticalAlignment="Center" FontSize="12" Classes="secondary" />
          </StackPanel>
        </StackPanel>
        </Border>

        <!-- Exits -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="EXITS" />
          <CheckBox Name="ShowConditionsBox" Content="Show an exit's conditions when it is selected" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Conditions appear under the exit's name in the list. Double-click a row to fold them away for that exit. The warning marker and the ring on the map stay either way, so you can still tell which exits have conditions." />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Guide line" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ColorPicker Name="GuideColorPicker" Width="120" HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Used only while the line is pointing at an exit. Routing you along your own markers keeps it pink, so the two are never confused." />
        </StackPanel>
        </Border>

        <!-- Minimap -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="MINIMAP" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="A small always-on-top map that can sit over the game. Open it from the Minimap button on the toolbar. It always follows you, and its opacity slider is on the window itself." />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Shows" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="MinimapRangeBox" Minimum="25" Maximum="1000" Increment="25"
                           Width="120" FormatString="0" />
            <TextBlock Text="m around you" VerticalAlignment="Center" FontSize="12"
                       Classes="secondary" />
          </StackPanel>

          <CheckBox Name="MinimapClickThroughBox" Content="Let clicks pass through to the game"
                    Margin="0,4,0,0" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Stops the minimap taking clicks meant for the game. It also stops you moving, resizing or closing the window, so this switch lives here rather than on the minimap itself." />
        </StackPanel>
        </Border>

        <!-- Party -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="PARTY" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="The name your squad sees when you share positions. Local only: there are no accounts, and nothing checks it." />
          <TextBox Name="PlayerNameBox" Watermark="Your name" MaxLength="16" />
          <TextBlock Name="PlayerNameHint" Classes="secondary" FontSize="11" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <TextBlock Text="Port" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="PartyPortBox" Minimum="1024" Maximum="49151" Increment="1"
                           Width="140" FormatString="0" />
          </StackPanel>
          <SelectableTextBlock Name="PartyPortHint" Classes="secondary" FontSize="11" TextWrapping="Wrap" />

          <CheckBox Name="PingSoundBox" Content="Play a sound when someone pings" Margin="0,6,0,0" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Shift-click the map to ping a spot. It lasts 30 seconds and everyone in the session sees it." />

          <CheckBox Name="ShowOffScreenPeersBox" Content="Point an arrow at teammates off the edge of the view"
                    Margin="0,6,0,0" />
          <CheckBox Name="ShareRouteBox" Content="Share your route markers with the squad" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Teammates see your markers in your color, and each one disappears for everybody as you reach it. Theirs never redirect your guide line." />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Trail" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="PeerTrailBox" Minimum="0" Maximum="20" Increment="1"
                           Width="120" FormatString="0" />
            <TextBlock Name="PeerTrailLabel" VerticalAlignment="Center" FontSize="12"
                       Classes="secondary" />
          </StackPanel>
        </StackPanel>
        </Border>

        <!-- Route markers -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="ROUTE MARKERS" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Markers you place with the Mark Route button. The guide line visits them in order before pointing at your chosen exit." />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Reached at" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="ArrivalRadiusBox" Minimum="5" Maximum="200" Increment="5"
                           Width="120" FormatString="0" />
            <TextBlock Text="m" VerticalAlignment="Center" FontSize="12" Classes="secondary" />
          </StackPanel>

          <RadioButton Name="ArrivalMarkThenRemove" GroupName="Arrival"
                       Content="Show a marker as reached for one screenshot, then remove it" />
          <RadioButton Name="ArrivalRemoveOnArrival" GroupName="Arrival"
                       Content="Remove a marker as soon as you are inside the radius" />

          <CheckBox Name="AnimateArrowsBox" Content="Move the arrows along the route" Margin="0,6,0,0" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="Off still draws the arrows, they just hold still. It also lets the map stop redrawing entirely when nothing else is moving." />
        </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="APPEARANCE" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Theme" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ComboBox Name="ThemeBox" Width="160" />
          </StackPanel>
          <TextBlock Name="FontLabel" Classes="secondary" FontSize="11" Margin="0,6,0,0" />
          <Slider Name="FontSlider" Minimum="11" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True" />
          <CheckBox Name="AlwaysOnTopBox" Content="Keep the window above other windows" />
        </StackPanel>
        </Border>

        <!-- Data -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="MAP DATA" />
          <CheckBox Name="AllowNetworkBox" Content="Download map images and exit data from tarkov.dev" />
          <TextBlock Name="DataStatus" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="RefreshDataButton" Content="Refresh now" />
            <Button Name="OpenCacheButton" Content="Open cache folder" />
          </StackPanel>
        </StackPanel>
        </Border>

      </StackPanel>
      </Border>
    </ScrollViewer>

  </DockPanel>

</Window>
