<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:TarkovMapCompanion.Localization"
        mc:Ignorable="d"
        x:Class="TarkovMapCompanion.Views.PreferencesWindow"
        Title="{loc:Tr Prefs.Title}"
        Width="600" Height="620"
        MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <DockPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Name="SettingsPathText"
                   Classes="secondary" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Name="CloseButton" Content="{loc:Tr Common.Close}" Classes="accent" Padding="16,4" />
      </Grid>
    </Border>

    <!--
      A ScrollViewer measures its content with unbounded width, so the TextBox below reports the
      full pixel width of whatever folder path it holds, the star column sizes to that, and every
      wrapping TextBlock in the panel then wraps to a width wider than the window. Pinning the
      content to the viewport width is what actually stops that; HorizontalScrollBarVisibility
      alone does not, because the Border is what has to be constrained.
      Padding lives on the Border, inside MaxWidth, rather than on the ScrollViewer, so the
      content plus its margins still fits.
    -->
    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <Border Padding="16" MaxWidth="{Binding #Scroller.Viewport.Width}">
      <StackPanel Spacing="18">

        <!--
          Every section is boxed. With eight of them in one scroller, a heading alone did not say
          where one topic stopped and the next started, so a setting read as belonging to whichever
          heading happened to be above it on screen.
        -->

        <!-- Screenshots -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.ScreenshotsHeading}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.ScreenshotsIntro}" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Name="FolderBox" FontSize="12" />
            <Button Grid.Column="1" Name="BrowseButton" Content="{loc:Tr Common.Browse}" />
            <Button Grid.Column="2" Name="DetectFolderButton" Content="{loc:Tr Common.Find}"
                    ToolTip.Tip="{loc:Tr Prefs.FindFolderTip}" />
            <Button Grid.Column="3" Name="DefaultFolderButton" Content="{loc:Tr Prefs.Default}" />
          </Grid>
          <TextBlock Name="FolderStatus" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <!-- Culling. Destructive, so it gets its own framing and an explicit warning. -->
        <Border Classes="panel" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="{loc:Tr Prefs.CullingHeading}" />
            <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                       Text="{loc:Tr Prefs.CullingIntro}" />

            <RadioButton Name="CullOff" GroupName="Cull" Content="{loc:Tr Prefs.CullKeepEverything}" />
            <RadioButton Name="CullKeepLatest" GroupName="Cull" Content="{loc:Tr Prefs.CullKeepNewest}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
              <NumericUpDown Name="CullCount" Minimum="1" Maximum="10000" Increment="5"
                             Width="120" FormatString="0" />
              <TextBlock Text="{loc:Tr Prefs.ScreenshotsUnit}" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
            <RadioButton Name="CullAfterRead" GroupName="Cull" Content="{loc:Tr Prefs.CullAfterRead}" />

            <TextBlock Name="CullWarning" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" IsVisible="False" />
          </StackPanel>
        </Border>

        <!--
          The game's own log. Its own section rather than a line under SCREENSHOTS, because it is
          a second and different input to the app and the difference is worth being explicit about.
        -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.GameLogHeading}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.GameLogIntro}" />

          <CheckBox Name="ReadGameLogBox" Content="{loc:Tr Prefs.ReadGameLog}" />
          <CheckBox Name="AutoSwitchFromLogBox" Content="{loc:Tr Prefs.AutoSwitchFromLog}"
                    Margin="24,0,0,0" />

          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,0">
            <TextBox Grid.Column="0" Name="GameLogFolderBox" FontSize="12"
                     Watermark="{loc:Tr Prefs.GameLogFolderWatermark}" />
            <Button Grid.Column="1" Name="BrowseLogButton" Content="{loc:Tr Common.Browse}" />
            <Button Grid.Column="2" Name="DetectLogButton" Content="{loc:Tr Common.Find}"
                    ToolTip.Tip="{loc:Tr Prefs.FindLogTip}" />
          </Grid>
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.GameLogFolderHint}" />

          <TextBlock Name="GameLogStatus" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <!-- View -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.ViewHeading}" />
          <CheckBox Name="SmoothCameraBox" Content="{loc:Tr Prefs.SmoothCamera}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.FollowPlayerHint}" />
          <CheckBox Name="SuggestMapBox" Content="{loc:Tr Prefs.SuggestMap}" />
          <CheckBox Name="AutoSwitchBox" Content="{loc:Tr Prefs.AutoSwitchMap}" Margin="24,0,0,0" />

          <TextBlock Name="PaddingLabel" Classes="secondary" FontSize="11" Margin="0,6,0,0" />
          <Slider Name="PaddingSlider" Minimum="0" Maximum="0.75" />

          <TextBlock Name="TrailLabel" Classes="secondary" FontSize="11" />
          <Slider Name="TrailSlider" Minimum="0" Maximum="60" />

          <TextBlock Name="RaidLengthText" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <!-- Your marker -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.MarkerHeading}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.MarkerIntro}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Prefs.Color}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ColorPicker Name="PlayerColorPicker" Width="120" HorizontalAlignment="Left" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{loc:Tr Prefs.Size}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="PlayerSizeBox" Minimum="10" Maximum="48" Increment="1"
                           Width="120" FormatString="0" />
            <TextBlock Text="{loc:Tr Common.Px}" VerticalAlignment="Center" FontSize="12" Classes="secondary" />
          </StackPanel>
        </StackPanel>
        </Border>

        <!-- Exits -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.ExitsHeading}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{loc:Tr Prefs.ExitFilterLabel}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ComboBox Name="ExitFilterBox" Width="180"
                      ToolTip.Tip="{loc:Tr Prefs.ExitFilterTip}" />
          </StackPanel>
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.ExitFilterHint}" />

          <CheckBox Name="ShowConditionsBox" Content="{loc:Tr Prefs.ShowConditions}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.ShowConditionsHint}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Prefs.GuideLine}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ColorPicker Name="GuideColorPicker" Width="120" HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.GuideLineHint}" />
        </StackPanel>
        </Border>

        <!-- Quests -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.QuestsHeading}" />
          <CheckBox Name="LevelFromLogBox" Content="{loc:Tr Prefs.LevelFromLog}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.LevelFromLogHint}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Prefs.LevelLabel}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="PlayerLevelBox" Minimum="1" Maximum="79" Increment="1"
                           Width="120" FormatString="0" />
          </StackPanel>
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.LevelHint}" />
        </StackPanel>
        </Border>

        <!-- Minimap -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.MinimapHeading}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.MinimapIntro}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Prefs.MinimapRangeLabel}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="MinimapRangeBox" Minimum="25" Maximum="1000" Increment="25"
                           Width="120" FormatString="0" />
            <TextBlock Text="{loc:Tr Prefs.MinimapRangeUnit}" VerticalAlignment="Center" FontSize="12"
                       Classes="secondary" />
          </StackPanel>

          <CheckBox Name="MinimapClickThroughBox" Content="{loc:Tr Prefs.MinimapClickThrough}"
                    Margin="0,4,0,0" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.MinimapClickThroughHint}" />
        </StackPanel>
        </Border>

        <!-- Party -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.PartyHeading}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.PartyNameHint}" />
          <TextBox Name="PlayerNameBox" Watermark="{loc:Tr Prefs.PlayerNameWatermark}" MaxLength="16" />
          <TextBlock Name="PlayerNameHint" Classes="secondary" FontSize="11" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <TextBlock Text="{loc:Tr Prefs.PortLabel}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="PartyPortBox" Minimum="1024" Maximum="49151" Increment="1"
                           Width="140" FormatString="0" />
          </StackPanel>
          <SelectableTextBlock Name="PartyPortHint" Classes="secondary" FontSize="11" TextWrapping="Wrap" />

          <CheckBox Name="PingSoundBox" Content="{loc:Tr Prefs.PingSound}" Margin="0,6,0,0" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.PingSoundHint}" />

          <CheckBox Name="ShowOffScreenPeersBox" Content="{loc:Tr Prefs.ShowOffScreenPeers}"
                    Margin="0,6,0,0" />
          <CheckBox Name="ShareRouteBox" Content="{loc:Tr Prefs.ShareRoute}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.ShareRouteHint}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Prefs.TrailLabel}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="PeerTrailBox" Minimum="0" Maximum="20" Increment="1"
                           Width="120" FormatString="0" />
            <TextBlock Name="PeerTrailLabel" VerticalAlignment="Center" FontSize="12"
                       Classes="secondary" />
          </StackPanel>
        </StackPanel>
        </Border>

        <!--
          WebSync: serves a read-only mirror of the current map to a tablet on the same Wi-Fi.
          Sits next to Party because both are about reaching another device over the local network,
          and it copies that section's shape: heading, hint, then label + control rows.
        -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr WebSync.Section}" />
          <CheckBox Name="WebSyncEnableBox" Content="{loc:Tr WebSync.Enable}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr WebSync.EnableHint}" />
          <TextBlock Name="WebSyncStatus" Classes="secondary" FontSize="11" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr WebSync.Port}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="WebSyncPortBox" Minimum="1024" Maximum="65535" Increment="1"
                           Width="140" FormatString="0" />
          </StackPanel>
          <TextBlock Name="WebSyncPortHint" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource DangerBrush}" IsVisible="False" />

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
            <TextBlock Grid.Column="0" Text="{loc:Tr WebSync.Url}" VerticalAlignment="Center"
                       Width="70" FontSize="12" />
            <TextBox Grid.Column="1" Name="WebSyncUrlBox" IsReadOnly="True" FontSize="12" />
            <Button Grid.Column="2" Name="WebSyncCopyButton" Content="{loc:Tr WebSync.Copy}" />
          </Grid>
          <TextBlock Name="WebSyncCopyNote" Classes="secondary" FontSize="11" IsVisible="False" />

          <!--
            8 pixels per module comes out a few hundred pixels wide, so this is a downscale; the
            high-quality filter keeps the modules from aliasing away at the display size.
          -->
          <Image Name="WebSyncQrImage" Width="160" Height="160" HorizontalAlignment="Left"
                 Stretch="Uniform" Margin="0,4,0,0"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr WebSync.QrHint}" />

          <Button Name="WebSyncRegenerateButton" Content="{loc:Tr WebSync.RegenerateToken}"
                  HorizontalAlignment="Left" Margin="0,6,0,0" />
          <TextBlock Name="WebSyncRegenerateNote" Classes="secondary" FontSize="11"
                     TextWrapping="Wrap" IsVisible="False" />

          <CheckBox Name="WebSyncFollowFloorBox" Content="{loc:Tr WebSync.FollowPlayerFloor}"
                    Margin="0,6,0,0" />
          <CheckBox Name="WebSyncShowPoisBox" Content="{loc:Tr WebSync.ShowPois}" />
          <CheckBox Name="WebSyncShowQuestsBox" Content="{loc:Tr WebSync.ShowQuests}" />
          <CheckBox Name="WebSyncShowAnnotationsBox" Content="{loc:Tr WebSync.ShowAnnotations}" />
        </StackPanel>
        </Border>

        <!-- Route markers -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.RouteHeading}" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.RouteIntro}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="{loc:Tr Prefs.ReachedAt}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <NumericUpDown Name="ArrivalRadiusBox" Minimum="5" Maximum="200" Increment="5"
                           Width="120" FormatString="0" />
            <TextBlock Text="{loc:Tr Common.Meters}" VerticalAlignment="Center" FontSize="12" Classes="secondary" />
          </StackPanel>

          <RadioButton Name="ArrivalMarkThenRemove" GroupName="Arrival"
                       Content="{loc:Tr Prefs.ArrivalMarkThenRemove}" />
          <RadioButton Name="ArrivalRemoveOnArrival" GroupName="Arrival"
                       Content="{loc:Tr Prefs.ArrivalRemoveOnArrival}" />

          <CheckBox Name="AnimateArrowsBox" Content="{loc:Tr Prefs.AnimateArrows}" Margin="0,6,0,0" />
          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     Text="{loc:Tr Prefs.AnimateArrowsHint}" />
        </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.AppearanceHeading}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{loc:Tr Prefs.ThemeLabel}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ComboBox Name="ThemeBox" Width="160" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Name="LanguageLabel" Text="{loc:Tr prefs.language}" VerticalAlignment="Center" Width="70" FontSize="12" />
            <ComboBox Name="LanguageBox" Width="160" />
          </StackPanel>
          <TextBlock Name="LanguageRestartText" Classes="secondary" FontSize="11"
                     TextWrapping="Wrap" IsVisible="False" />
          <TextBlock Name="FontLabel" Classes="secondary" FontSize="11" Margin="0,6,0,0" />
          <Slider Name="FontSlider" Minimum="11" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True" />
          <CheckBox Name="AlwaysOnTopBox" Content="{loc:Tr Prefs.AlwaysOnTop}" />
        </StackPanel>
        </Border>

        <!-- Data -->
        <Border Classes="panel" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr Prefs.MapDataHeading}" />
          <CheckBox Name="AllowNetworkBox" Content="{loc:Tr Prefs.AllowNetwork}" />
          <TextBlock Name="DataStatus" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="RefreshDataButton" Content="{loc:Tr Prefs.RefreshNow}" />
            <Button Name="OpenCacheButton" Content="{loc:Tr Prefs.OpenCache}" />
          </StackPanel>
        </StackPanel>
        </Border>

      </StackPanel>
      </Border>
    </ScrollViewer>

  </DockPanel>

</Window>
