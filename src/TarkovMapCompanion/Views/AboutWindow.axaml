<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:TarkovMapCompanion.Views"
        xmlns:loc="using:TarkovMapCompanion.Localization"
        mc:Ignorable="d"
        x:Class="TarkovMapCompanion.Views.AboutWindow"
        Title="{loc:Tr About.Title}"
        Width="620" Height="540"
        MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBaseBrush}">

  <DockPanel>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfacePanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <Button Name="CloseButton" Content="{loc:Tr Common.Close}" Classes="accent"
              HorizontalAlignment="Right" Padding="16,4" />
    </Border>

    <!--
      Pinned to the viewport width for the same reason as the preferences window: a ScrollViewer
      measures with unbounded width, and the unbroken data-source URLs below would otherwise set
      the panel width and push every wrapping paragraph past the window edge.
    -->
    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <Border Padding="18" MaxWidth="{Binding #Scroller.Viewport.Width}">
      <StackPanel Spacing="16">

        <StackPanel Spacing="3">
          <TextBlock Text="{loc:Tr About.AppName}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Name="VersionText" Classes="secondary" FontSize="11" />
        </StackPanel>

        <Border Classes="panel" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="heading" Text="{loc:Tr About.HowItWorksHeading}" />
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Text="{loc:Tr About.HowItWorks1}" />
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Text="{loc:Tr About.HowItWorks2}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr About.MapsHeading}" />
          <TextBlock TextWrapping="Wrap" FontSize="12"
                     Text="{loc:Tr About.MapsIntro}" />

          <ItemsControl Name="CreditsList" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:Credit">
                <Grid ColumnDefinitions="130,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Who}" FontSize="12"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding What}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="{loc:Tr About.MapGeometry}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Name="TarkovDevButton" Content="{loc:Tr About.TarkovDevButton}" />
            <Button Name="SourceButton" Content="{loc:Tr About.SourceButton}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr About.SourcesHeading}" />
          <TextBlock Name="SourcesText" Classes="secondary" FontSize="11" TextWrapping="Wrap"
                     FontFamily="{DynamicResource MonoFont}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="heading" Text="{loc:Tr About.BuiltWithHeading}" />
          <TextBlock Name="StackText" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Classes="secondary" FontSize="11" TextWrapping="Wrap"
                   Text="{loc:Tr About.Trademark}" />

      </StackPanel>
      </Border>
    </ScrollViewer>

  </DockPanel>

</Window>
